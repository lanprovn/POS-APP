generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id                    String                 @id @default(cuid())
  sku                   String                 @unique
  barcode               String?                @unique
  name                  String
  description           String?
  costPrice             Float                  @default(0)
  sellingPrice          Float
  stockQuantity         Int                    @default(0)
  minStockThreshold     Int                    @default(5)
  unit                  String                 @default("Cái")
  imageUrl              String?
  isActive              Boolean                @default(true)
  categoryId            String?
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]
  returnItems           ReturnItem[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([sku])
  @@index([barcode])
  @@index([name])
  @@map("products")
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  phone      String?  @unique
  email      String?
  address    String?
  totalSpent     Float           @default(0)
  points         Int             @default(0)
  orders         Order[]
  returnReceipts ReturnReceipt[]
  createdAt      DateTime        @default(now())
  updatedAt  DateTime @updatedAt

  @@map("customers")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  subtotalAmount  Float
  discountAmount  Float       @default(0)
  taxAmount       Float       @default(0)
  finalAmount     Float
  customerPayment Float       @default(0)
  changeAmount    Float       @default(0)
  paymentMethod   String      @default("CASH") // CASH, BANK_TRANSFER, CARD
  paymentStatus   String      @default("PAID") // PAID, PENDING, REFUNDED
  orderStatus     String      @default("COMPLETED") // COMPLETED, CANCELLED
  cashierName     String      @default("Thu ngân")
  notes           String?
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shiftId         String?
  shift           CashShift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  returnReceipts  ReturnReceipt[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  unitPrice   Float
  costPrice   Float    @default(0)
  quantity    Int
  subtotal    Float

  @@map("order_items")
}

model InventoryTransaction {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           String // SALE, RESTOCK, ADJUSTMENT, RETURN
  quantityChange Int
  previousStock  Int
  newStock       Int
  referenceId    String? // Order ID, Purchase Order ID
  note           String?
  createdAt      DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model CashShift {
  id           String            @id @default(cuid())
  shiftCode    String            @unique
  cashierName  String
  status       String            @default("OPEN") // OPEN, CLOSED
  startTime    DateTime          @default(now())
  endTime      DateTime?
  startingCash Float             @default(0) // Tiền mặt ban đầu trong két
  endingCash   Float?            // Tiền mặt kiểm đếm thực tế khi đóng ca
  expectedCash Float             @default(0) // Tiền mặt lý thuyết hệ thống tính
  difference   Float?            // Chênh lệch (endingCash - expectedCash)
  cashSales    Float             @default(0) // Doanh thu tiền mặt
  bankSales    Float             @default(0) // Doanh thu chuyển khoản VietQR
  cardSales    Float             @default(0) // Doanh thu thẻ
  totalSales   Float             @default(0) // Tổng doanh thu
  ordersCount  Int               @default(0) // Số đơn hàng
  cashPayout   Float             @default(0) // Chi tiền mặt phát sinh (mua đá, túi xốp...)
  cashDrop     Float             @default(0) // Rút tiền nộp két chính
  cashIn       Float             @default(0) // Nạp thêm tiền mặt
  notes        String?
  orders         Order[]
  transactions   CashTransaction[]
  returnReceipts ReturnReceipt[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([shiftCode])
  @@index([status])
  @@index([startTime])
  @@map("cash_shifts")
}

model CashTransaction {
  id          String    @id @default(cuid())
  shiftId     String
  shift       CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type        String    // PAYOUT (Chi ra), DROP (Nộp két), IN (Nạp thêm)
  amount      Float
  reason      String
  performedBy String    @default("Thu ngân")
  createdAt   DateTime  @default(now())

  @@index([shiftId])
  @@map("cash_transactions")
}

model ReturnReceipt {
  id                String       @id @default(cuid())
  returnNumber      String       @unique // ví dụ: TH-20261031-0001
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId        String?
  customer          Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shiftId           String?
  shift             CashShift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  totalRefundAmount Float        @default(0)
  refundMethod      String       @default("CASH") // CASH, BANK_TRANSFER
  reason            String?      // Hàng lỗi kỹ thuật, Khách đổi ý, Sai quy cách, Quá hạn, Khác...
  cashierName       String       @default("Thu ngân")
  notes             String?
  items             ReturnItem[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([returnNumber])
  @@index([orderId])
  @@index([createdAt])
  @@map("return_receipts")
}

model ReturnItem {
  id                 String        @id @default(cuid())
  returnId           String
  returnReceipt      ReturnReceipt @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId        String?
  productId          String?
  product            Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName        String
  sku                String
  quantity           Int           // Số lượng hoàn trả
  unitPrice          Float         // Đơn giá bán lúc mua
  refundAmount       Float         // Thành tiền hoàn (quantity * unitPrice)
  restockToInventory Boolean       @default(true) // Có hồi kho hay loại bỏ

  @@map("return_items")
}
